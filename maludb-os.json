{
  "schema": "maludb-os.application/1",
  "catalog_key": "shareholder_intelligence",
  "name": "Shareholder Intelligence",
  "description": "Shareholder surveillance for a publicly traded company (or an advisory firm serving several): the weekly DTC Security Position Report, Broadridge's NOBO list and the transfer agent's register uploaded, tied to their own totals and reconciled with the share count; holders matched across lists; SEC EDGAR filings and ownership forms (13F, 13D/13G, Forms 3/4/5, 144), FINRA short interest and daily short volume, the SEC's fails-to-deliver and the Reg SHO threshold lists fetched under a declared policy; every series charted against the price with the company's events; nineteen rules that raise signals with their evidence and whether that evidence is established, contested or lore, for a person to judge. Nothing leaves the business. The Expert works the command bar; the Surveillance Analyst writes the market-day morning note and drafts the weekly pack.",
  "business_area": "Finance",
  "category": "investor_relations",
  "icon": "feather-trending-down",
  "version": "0.1.0",
  "criticality": "medium",
  "vhost": {
    "label": "shareholders",
    "document_root": "html",
    "internal_port_env": "APP_INTERNAL_PORT"
  },
  "database": {
    "suffix": "shareholder_intelligence",
    "migrations": "db",
    "roles": {
      "rw": "shareholder_intelligence_rw",
      "records_ro": "shareholder_intelligence_records_ro",
      "activity_ro": "shareholder_intelligence_activity_ro"
    }
  },
  "runtime": {
    "python": {
      "dir": "mcp",
      "venv": "mcp/venv",
      "requirements": "mcp/requirements.txt"
    }
  },
  "env": {
    "required": [
      "APP_NAME",
      "APP_URL",
      "DB_HOST",
      "DB_PORT",
      "DB_NAME",
      "DB_USER",
      "DB_PASSWORD",
      "MCP_RECORDS_DB_USER",
      "MCP_RECORDS_DB_PASSWORD",
      "MCP_ACTIVITY_DB_USER",
      "MCP_ACTIVITY_DB_PASSWORD",
      "APP_INTERNAL_PORT",
      "MCP_RECORDS_PORT",
      "MCP_ACTIVITY_PORT",
      "ACTION_TOKEN_KEY",
      "ACTIONS_RELAY_KEY",
      "OS_APPLICATION_TOKEN",
      "OS_INTERNAL_URL",
      "OS_LAUNCHER_URL",
      "APP_KEY",
      "MALUDB_API_URL",
      "MALUDB_API_TOKEN",
      "SI_SECRETS_KEY"
    ],
    "optional": [
      "MALUMAIL_API_KEY",
      "MAIL_FROM",
      "MAIL_FROM_NAME",
      "SI_STORAGE_DIR",
      "SI_MAX_UPLOAD_BYTES",
      "SI_WKHTMLTOPDF",
      "API_CORS_ORIGINS"
    ]
  },
  "settings_required_at_install": [
    {
      "table": "si_settings",
      "column": "business_name",
      "why": "the first half of the EDGAR user-agent the SEC requires (K35: the installer warns while empty)"
    },
    {
      "table": "si_settings",
      "column": "edgar_contact_email",
      "why": "the second half — a contact the SEC may write to; without it no EDGAR pull runs"
    }
  ],
  "services": [
    "deploy/shareholder_intelligence-records-mcp.service",
    "deploy/shareholder_intelligence-activity-mcp.service",
    "deploy/shareholder_intelligence-activity-ingest.service",
    "deploy/shareholder_intelligence-activity-ingest.timer",
    "deploy/shareholder_intelligence-directory-sync.service",
    "deploy/shareholder_intelligence-directory-sync.timer",
    "deploy/shareholder_intelligence-worker.service",
    "deploy/shareholder_intelligence-worker.timer"
  ],
