# Shareholder Intelligence — config/.env (written by the kernel's installer at apply; design §14). Never commit the real file.
APP_ENV=prod
APP_DEBUG=0
APP_NAME="Shareholder Intelligence"
APP_KEY=shareholder_intelligence
APP_URL=https://shareholders.example.com
# the record database (the installer creates it and the three roles)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=subello_shareholder_intelligence
DB_USER=shareholder_intelligence_rw
DB_PASSWORD=
MCP_RECORDS_DB_USER=shareholder_intelligence_records_ro
MCP_RECORDS_DB_PASSWORD=
MCP_ACTIVITY_DB_USER=shareholder_intelligence_activity_ro
MCP_ACTIVITY_DB_PASSWORD=
# the ports (pinned before the first apply: deploy/ROOT_STEPS.sh step 0)
APP_INTERNAL_PORT=8192
MCP_RECORDS_PORT=8845
MCP_ACTIVITY_PORT=8846
# the kernel's (copied by the installer)
ACTION_TOKEN_KEY=
ACTIONS_RELAY_KEY=
OS_APPLICATION_TOKEN=
OS_INTERNAL_URL=http://127.0.0.1:8080
OS_LAUNCHER_URL=https://app.example.com/
# the tenant's one memory (activity episodes)
MALUDB_API_URL=http://127.0.0.1:8000
MALUDB_API_TOKEN=
# mail (optional; the installer fills them from ~/.malumail or the kernel's)
MALUMAIL_API_URL=https://api.malumail.com
MALUMAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=
# the box key for the sources' credentials (a market-data key, a licensed short-data key): generated once at install, never rotated by hand
SI_SECRETS_KEY=
# attachments (the uploaded files kept whole), import files and exports, the rendered packs: default storage/ under the install; a mount the owner names
SI_STORAGE_DIR=
# may only LOWER si_settings.max_upload_bytes
SI_MAX_UPLOAD_BYTES=
# the PDF renderer for the packs when not on PATH (HTML only without it)
SI_WKHTMLTOPDF=
# CORS origins for the token API, comma-separated (none by default)
API_CORS_ORIGINS=
