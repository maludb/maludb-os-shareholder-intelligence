[Unit]
Description=Shareholder Intelligence worker: the fetch schedule (EDGAR, FINRA, the SEC's fails, the threshold lists, DTCC's directory, prices), the upload queue, the matcher, the reconciliation, the rules, the search index catch-up, packs and exports, the outbox, dispatches, tombstone purge, key-usage pruning (one pass)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory={{APP_DIR}}
ExecStart=/usr/bin/php {{APP_DIR}}/bin/worker.php
