{
  "schema": "maludb-os.registry/1",
  "app_key": "shareholder_intelligence",
  "name": "Shareholder Intelligence",
  "note": "The installer (bin/app_install.php, step 'registry') writes mcp/registries/shareholder_intelligence.json in the kernel from this file's `resolve` block plus mcp/action_registry.json (Phase 1). Each resolve tool answers a plain LIST of rows carrying id_field and label_field when given `q` alone (docs/shareholder-intelligence-mcp-tool-surface.md, the resolution table). The tools are the Phase 1 tool surface's names; Phase 4 builds them (mcp/records_server.py). Upload, row, proposal, dispatch, notification, token and share-count ids are ids only, never resolved by name. A repeated param (tags, members) is never resolved. A HOLDER is resolved only for an Analyst (the PII wall: the resolver answers a Viewer nothing).",
  "resolve": {
    "issuer":       {"tool": "find_issuers",      "query_param": "q", "id_field": "issuer_id",      "label_field": "name",         "params": ["issuer", "company"]},
    "security":     {"tool": "find_securities",   "query_param": "q", "id_field": "security_id",    "label_field": "name",         "params": ["security", "cusip", "class"]},
    "participant":  {"tool": "find_participants", "query_param": "q", "id_field": "participant_id", "label_field": "name",         "params": ["participant", "broker", "custodian"]},
    "holder":       {"tool": "find_holders",      "query_param": "q", "id_field": "holder_id",      "label_field": "display_name", "params": ["holder", "survivor", "loser"]},
    "institution":  {"tool": "find_institutions", "query_param": "q", "id_field": "institution_id", "label_field": "name",         "params": ["institution", "filer", "fund"]},
    "filing":       {"tool": "find_filings",      "query_param": "q", "id_field": "filing_id",      "label_field": "label",        "params": ["filing"]},
    "event":        {"tool": "find_events",       "query_param": "q", "id_field": "event_id",       "label_field": "title",        "params": ["event", "explaining_event"]},
    "signal":       {"tool": "find_signals",      "query_param": "q", "id_field": "signal_id",      "label_field": "summary",      "params": ["signal"]},
    "rule":         {"tool": "find_rules",        "query_param": "q", "id_field": "rule_id",        "label_field": "name",         "params": ["rule"]},
    "import":       {"tool": "find_imports",      "query_param": "q", "id_field": "import_id",      "label_field": "file_name",    "params": ["upload", "import"]},
    "report":       {"tool": "find_reports",      "query_param": "q", "id_field": "report_id",      "label_field": "title",        "params": ["report", "pack"]},
    "source":       {"tool": "find_sources",      "query_param": "q", "id_field": "source_id",      "label_field": "name",         "params": ["source", "fetcher"]},
    "instrument":   {"tool": "dilution_instruments","query_param": "q","id_field": "instrument_id",  "label_field": "label",        "params": ["instrument"]},
    "tag":          {"tool": "find_tags",         "query_param": "q", "id_field": "tag_id",         "label_field": "label",        "params": ["tag"]},
    "api_key":      {"tool": "find_keys",         "query_param": "q", "id_field": "key_id",         "label_field": "label",        "params": ["api_key"]},
    "member":       {"tool": "find_members",      "query_param": "q", "id_field": "member_id",      "label_field": "display_name", "params": ["member", "person_member", "agent", "recipient", "who"]},
    "department":   {"tool": "find_departments",  "query_param": "q", "id_field": "department_id",  "label_field": "name",         "params": ["department"]}
  }
}
